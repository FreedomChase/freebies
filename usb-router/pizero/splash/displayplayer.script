# Display Player boot splash (C&G #209 v8.4, Shaun 17 Nov 09:53 CET: icon only, no brand word; a progress bar
# and "Setting up, please wait..."; 10:00 CET: the icon back, above the text). bg.png, icon.png,
# text.png, track.png and fill.png are
# rendered from the setup page's .boot-splash (splash/render.py) at 1920x1080 and drawn here in
# the page's own proportions (icon 11vh + 4vh, text 2.1vw, gap 3.4vh, bar 26vw x 0.7vh, centred as one column),
# so the handoff to the page's splash does not jump. Plymouth fills the bar to 60 % with the
# boot's progress; the page carries on from 60 %.
Window.SetBackgroundTopColor(0.078, 0.384, 0.675);
Window.SetBackgroundBottomColor(0.004, 0.035, 0.075);
W = Window.GetWidth();
H = Window.GetHeight();
X = Window.GetX();
Y = Window.GetY();
k = W / 1920;
bg = Sprite(Image("bg.png").Scale(W, H));
bg.SetPosition(X, Y, -10);
ti = Image("text.png");
tw = Math.Int(ti.GetWidth() * k);
th = Math.Int(ti.GetHeight() * k);
bw = Math.Int(W * 0.26);
bh = Math.Int(H * 0.007);
if (bh < 5) bh = 5;
gap = Math.Int(H * 0.034);
ii = Image("icon.png");
iw = Math.Int(ii.GetWidth() * k);
ih = Math.Int(ii.GetHeight() * k);
igap = Math.Int(H * 0.040);
top = Y + Math.Int((H - (ih + igap + th + gap + bh)) / 2);
icon = Sprite(ii.Scale(iw, ih));
icon.SetPosition(X + Math.Int((W - iw) / 2), top, 10);
ty = top + ih + igap;
text = Sprite(ti.Scale(tw, th));
text.SetPosition(X + Math.Int((W - tw) / 2), ty, 10);
bx = X + Math.Int((W - bw) / 2);
by = ty + th + gap;
track = Sprite(Image("track.png").Scale(bw, bh));
track.SetPosition(bx, by, 10);
fill_src = Image("fill.png");
fill = Sprite();
fill.SetPosition(bx, by, 11);
fun progress(duration, p) {
  w = Math.Int(global.bw * 0.6 * p);
  if (w < global.bh) w = global.bh;
  global.fill.SetImage(global.fill_src.Scale(w, global.bh));
}
Plymouth.SetBootProgressFunction(progress);
progress(0, 0);
# no other text: messages, prompts and status are not drawn
fun quiet(text) { }
Plymouth.SetMessageFunction(quiet);
Plymouth.SetUpdateStatusFunction(quiet);

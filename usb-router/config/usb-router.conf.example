# USB Router / signage screen configuration
#
# Copy this file to the USBROUTER drive on the stick as "usb-router.conf"
# (a normal FAT drive, editable from Windows or macOS). Settings changed from
# the on-screen page or the fleet dashboard are saved on the stick and override
# the values here.

[usb-router]
# ---------------------------------------------------------------- content ---
# What the screen shows once online. {device_id} and {device_name} are replaced,
# so one file can serve a whole batch of sticks:
#   homepage = https://signage.example.com/play?screen={device_id}
homepage = https://duckduckgo.com

# true  = fullscreen, no address bar (signage). F11 or Esc brings the bar back,
#         Ctrl+N opens this setup page.
# false = a normal browser window with tabs; F11 toggles fullscreen.
kiosk = true
allow_exit = false

# Reload the content every N minutes (0 = never). Useful for dashboards that
# leak memory or pages without their own refresh.
reload_every = 0

# Portrait panels: left | right | inverted | normal
rotation = normal

# --------------------------------------------------------------- identity ---
# Leave device_id blank to derive a stable ID from the hardware (scr-xxxxxxxx).
# Set it when you pre-assign screens, e.g. device_id = lobby-left
device_id =
device_name =

# -------------------------------------------------------- zero-touch Wi-Fi ---
# Fill these in and the screen joins the network by itself; nobody has to touch
# it. Up to three networks (venue, staff, your phone's hotspot as a fallback).
wifi_ssid =
wifi_password =
wifi_ssid_2 =
wifi_password_2 =
wifi_ssid_3 =
wifi_password_3 =

# ----------------------------------------------------- phone-based setup ---
# While the screen is offline AND has no Wi-Fi configured yet, it broadcasts
# the hotspot below so you can set it up from a phone: join the Wi-Fi, open
# http://10.42.0.1:8080, pick the venue's network, type the admin PIN. QR codes,
# the password and the PIN are shown on the screen itself only. The hotspot
# switches off as soon as the screen is online; Ctrl+N on a keyboard (or the
# "Allow phone setup" button on the screen) brings it back for 15 minutes.
setup_hotspot = true

# ------------------------------------------------------------ secrets -------
# Leave both blank: each stick generates its own random hotspot password and
# 6-digit admin PIN at first boot and shows them on its screen. Set them only
# if you want the same values on every stick. Common defaults (changeme...,
# password, 12345678) are refused and replaced by a generated one.
hotspot_password =
admin_pin =

# ------------------------------------------------------------ sharing -------
# Share the internet connection with nearby devices once online (opt-in).
# Needs a spare adapter: a second Wi-Fi card or an Ethernet port.
hotspot_enabled = false
hotspot_ssid = USB-Router
# bg = 2.4 GHz (works with every phone), a = 5 GHz
hotspot_band = bg

# Serve this page to devices on the hotspot too (needed for phone-based setup).
# Every change made from another device needs the admin PIN (X-Admin-Pin).
lan_access = true

# ------------------------------------------------------ display network -----
# Optional central dashboard (see fleet/). Screens report in every
# fleet_interval seconds and pick up URL / rotation / reboot changes.
# The screen refuses to contact a dashboard without a token. Generate one with
#   openssl rand -hex 16
# and use the same value as FLEET_TOKEN on the dashboard.
fleet_url =
fleet_token =
fleet_interval = 60

# ------------------------------------------------------------ internals ----
check_url = http://connectivitycheck.gstatic.com/generate_204
check_fallback_url = http://detectportal.firefox.com/success.txt

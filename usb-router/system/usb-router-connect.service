[Unit]
Description=USB Router connection manager (web UI + hotspot keeper)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=kiosk
Group=netdev
Environment=PYTHONUNBUFFERED=1
Environment=USB_ROUTER_STATE_DIR=/var/lib/usb-router
ExecStartPre=+/bin/mkdir -p /var/lib/usb-router
ExecStartPre=+/bin/chown kiosk:netdev /var/lib/usb-router
# C&G #270: reset-settings.txt on the boot drive clears the settings saved on the screen, once
ExecStartPre=+/bin/sh /opt/usb-router/system/usb-router-reset-settings.sh /var/lib/usb-router
# captive portal (S&D #193): dnsmasq reads this file through the link in
# /etc/NetworkManager/dnsmasq-shared.d, so it must exist before any hotspot
ExecStartPre=+/bin/sh -c 'f=/var/lib/usb-router/captive-dns.conf; [ -e "$f" ] || : > "$f"; chown kiosk:netdev "$f"; chmod 644 "$f"'
# port 80 for the captive-portal redirect, nothing else
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 /opt/usb-router/app/server.py
Restart=always
RestartSec=2
# hardening: the service only needs to talk to NetworkManager over D-Bus
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/usb-router
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
